{
  "name": "webcmd-plugin-notion",
  "version": "0.1.0",
  "type": "module",
  "description": "Notion commands for Webcmd",
  "scripts": {
    "build": "npm run typecheck",
    "lint": "biome check lib/notion-button.mjs tests/button.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "node --check notion.js && node --check lib/notion-button.mjs && node --check lib/notion-database.mjs",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@agentrhq/webcmd": ">=0.5.2"
  },
  "devDependencies": {
    "@agentrhq/webcmd": "^0.5.2",
    "@biomejs/biome": "^2.2.0",
    "jsdom": "^29.1.1"
  },
  "dependencies": {
    "image-size": "^2.0.2",
    "marked": "^18.0.7"
  },
  "engines": {
    "node": ">=22"
  }
}
